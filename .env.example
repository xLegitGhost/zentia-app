# URL Base del backend de Zentia (Spring Boot)
EXPO_PUBLIC_API_URL=https://zentia-backend-5l77.onrender.com/api/v1

# Client ID de Google OAuth obtenido de Google Cloud Console (Tipo Web Application)
# Ejemplo: 1234567890-abcdef.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_CLIENT_ID=

# URL pública desplegada en Vercel (usada para generar el QR del stand)
EXPO_PUBLIC_DEMO_URL=https://zentia.vercel.app

# Opcionales para resiliencia de red e idempotencia (RN-20 / RN-25)
EXPO_PUBLIC_API_TIMEOUT_MS=15000
EXPO_PUBLIC_ENABLE_IDEMPOTENCY_HEADER=false
EXPO_PUBLIC_BACKEND_IDEMPOTENT=false
